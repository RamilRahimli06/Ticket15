
@model List<Agent>





<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">List of Agents</h6>
        <a asp-action="Create"  class="btn btn-success">Add Agent</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Position</th>
                        <th>Img Url</th>
                        <th>Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(Agent agent in Model)
                    {
                    <tr>
                        <td>@agent.FullName</td>
                        <td>@agent.Designation</td>
                        <td>@agent.ImgUrl</td>

                        <td>
                                <a asp-action="Update" asp-route-id="@agent.Id" type="button" class="btn btn-warning">Update</a>
                                <button type="button" class="btn btn-primary">Detail</button>
                                <a asp-action="Delete" asp-route-id="@agent.Id" type="button" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>