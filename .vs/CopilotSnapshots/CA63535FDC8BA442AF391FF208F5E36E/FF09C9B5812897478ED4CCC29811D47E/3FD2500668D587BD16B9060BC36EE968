@model List<Member>





<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">List of Members</h6>
        <a asp-action="Create" class="btn btn-success">Add Member</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>FullName</th>
                        <th>Salary</th>
                        <th>Point</th>
                        <th>Img Url</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Member member in Model)
                    {
                        <tr>
                            <td>@member.FullName</td>
                            <td>@member.Salary</td>
                            <td>@member.Point</td>
                            <td>@member.ImgUrl</td>

                            <td>
                                <a asp-action="Add" asp-route-id="@member.Id" type="button" class="btn btn-warning">Update</a>
                                <a asp-action="Detail" asp-route-id="@member.Id" class="btn btn-primary">Detail</a>
                                <a asp-action="Delete" asp-route-id="@member.Id" type="button" class="btn btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>