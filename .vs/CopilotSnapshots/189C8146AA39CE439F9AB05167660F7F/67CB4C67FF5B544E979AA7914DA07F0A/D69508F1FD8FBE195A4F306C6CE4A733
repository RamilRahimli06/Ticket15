using Microsoft.AspNetCore.Mvc;
using Ticket15.DAL;
using Ticket15.Models;
using Microsoft.EntityFrameworkCore;
using Microsoft.DiaSymReader;

namespace Ticket15.Areas.Admin.Controllers
{
    [Area("Admin")]
    public class MemberController : Controller
    {

        public readonly AppDbContext _dbContext;
        public MemberController(AppDbContext dbContext)
        {
            _dbContext = dbContext;
        }
        public async Task<IActionResult> Index()
        {
            List<Member> members = await _dbContext.Members.ToListAsync();
            return View(members);
        }



        [HttpGet]
        public IActionResult Create()
        {
            return View();
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Create(Member member)
        {
            if (!ModelState.IsValid)
            {
                return View(member);
            }

            await _dbContext.Members.AddAsync(member);
            await _dbContext.SaveChangesAsync();
            return RedirectToAction(nameof(Index));
        }










        public IActionResult Update(int? id)
        {
            if (id == null || id == 0)
                return BadRequest();

            Member member = _dbContext.Members.FirstOrDefault(c => c.Id == id);
            if (member == null)
                return NotFound();

            return View(member);
        }

        [HttpPost]
        public async Task<IActionResult> Update(int? id, Member member)
        {
            if (id == null || id < 1)
                return BadRequest();

            Member existed = _dbContext.Members.FirstOrDefault(c => c.Id == id);

            if (existed is null)
                return NotFound();

            if (!ModelState.IsValid)
            {
                return View(existed);
            }

            bool result = await _dbContext.Members.AnyAsync(c => c.ImgUrl == member.ImgUrl && c.Id != id);

            if (result)
            {
                ModelState.AddModelError("ImgUrl", "ImgUrl already exists");
                return View(existed);
            }
            existed.FullName = member.FullName;
            existed.Salary = member.Salary;
            existed.Point = member.Point;
            existed.ImgUrl = member.ImgUrl;
            await _dbContext.SaveChangesAsync();

            return RedirectToAction(nameof(Index));
        }


        public IActionResult Detail(int? id)
        {
            if (id == null || id < 1)
                return BadRequest();

            Member member = _dbContext.Members.FirstOrDefault(c => c.Id == id);
            if (member == null)
                return NotFound();

            return View(member);
        }


        [HttpPost]

        public async Task<IActionResult> Delete(int? id)
        {
            if (id == null || id < 1)
                return BadRequest();
            Member member = await _dbContext.Members.FirstOrDefaultAsync(c => c.Id == id);
            if (member == null)
                return NotFound();

            _dbContext.Members.Remove(member);
            await _dbContext.SaveChangesAsync();
            return RedirectToAction(nameof(Index));



            if (!member.PhotoFile.ContentType.Contains("img/"))
            {
                ModelState.AddModelError("Photo", "format sehvdi");
                return View();
            }

            if (member.PhotoFile.Length > 2 * 1024 * 1024)
            {
                ModelState.AddModelError("Photo", "olcu sehvdi");
                return View();
            }

            string path = "C:\\Users\\Nicat\\source\\repos\\Ticket15\\wwwroot\\admin\\img\\" + member.PhotoFile.FileName;
            FileStream fileStream = new FileStream(path, FileMode.Create);
            await member.PhotoFile.CopyToAsync(fileStream);

            member.ImgUrl = member.PhotoFile.FileName;

            return Content(member.PhotoFile.FileName + " " + member.PhotoFile.ContentType + " " + member.PhotoFile.Length);
        }
    }


}

