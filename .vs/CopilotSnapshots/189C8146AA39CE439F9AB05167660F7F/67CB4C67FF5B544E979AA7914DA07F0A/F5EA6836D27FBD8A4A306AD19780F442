@model Member

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Add Member</h6>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group mb-3">
                <label>FullName</label>
                <input asp-for="FullName" type="text" class="form-control" />
                <span asp-validation-for="FullName" style="color: red;"></span>
            </div>

            <div class="form-group mb-3">
                <label>Salary</label>
                <input asp-for="Salary" type="text" class="form-control" />
                <span asp-validation-for="Salary" style="color: red;"></span>
            </div>

            <div class="form-group mb-3">
                <label>Point</label>
                <input asp-for="Point" type="text" class="form-control" />
                <span asp-validation-for="Point" style="color: red;"></span>
            </div>

            <div class="form-group mb-3">
                <label>Image</label>
                <input asp-for="PhotoFile" type="file" class="form-control" />
                <span asp-validation-for="PhotoFile" style="color: red;"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">Add Member</button>
                <a asp-area="Admin" asp-controller="Member" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>