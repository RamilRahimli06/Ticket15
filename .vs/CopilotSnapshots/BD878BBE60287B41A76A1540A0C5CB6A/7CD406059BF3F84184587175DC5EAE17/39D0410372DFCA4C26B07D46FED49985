@model Member

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Update Member</h6>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label>FullName</label>
                <input asp-for="FullName" value="@Model.FullName" type="text" class="form-control" />
                <span asp-validation-for="FullName" style="color: red;"></span>
            </div>

            <div class="form-group mb-3">
                <label>Salary</label>
                <input asp-for="Salary" value="@Model.Salary" type="text" class="form-control" />
                <span asp-validation-for="Salary" style="color: red;"></span>
            </div>

            <div class="form-group mb-3">
                <label>Point</label>
                <input asp-for="Point" value="@Model.Point" type="text" class="form-control" />
                <span asp-validation-for="Point" style="color: red;"></span>
            </div>

            <div class="form-group mb-3">
                <label>Img Url</label>
                <input asp-for="ImgUrl" value="@Model.ImgUrl" type="text" class="form-control" />
                <span asp-validation-for="ImgUrl" style="color: red;"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">Update</button>
                <a asp-area="Admin" asp-controller="Member" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>