@model Member

<div class="card shadow mb-4">
	<div class="card-header py-3 d-flex justify-content-between align-items-center">
		<h6 class="m-0 font-weight-bold text-primary">Member Detail</h6>
		<a asp-area="Admin" asp-controller="Member" asp-action="Index" class="btn btn-secondary">Back</a>
	</div>
	<div class="card-body">
		<div class="row">
			<div class="col-md-4">
				<img src="@Model.ImgUrl" alt="@Model.FullName" class="img-fluid" />
			</div>
			<div class="col-md-8">
				<h3>@Model.FullName</h3>
				<p><strong>Salary:</strong> @Model.Salary</p>
				<p><strong>Point:</strong> @Model.Point</p>
			</div>
		</div>
	</div>
</div>
